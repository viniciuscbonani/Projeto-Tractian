APP_HOST=127.0.0.1
APP_PORT=8001
APP_DATABASE_PATH=./runtime/tractian-agent.sqlite3
GRAPH_CHECKPOINT_PATH=./runtime/langgraph-checkpoints.sqlite3
INDUSTRIAL_API_URL=http://127.0.0.1:8000
INDUSTRIAL_API_TIMEOUT_SECONDS=8
DEFAULT_SEED=complete
DEMO_CASES_PATH=../api-tractian/agent-input/cases.json
MODEL_VERSION_MAP={"3.2.1":"mdl_vib_v3","specialist_v1":"mdl_vib_v3"}
# Groq pela API OpenAI-compatible. Nunca envie a chave ao frontend.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
LLM_CLASSIFIER_MODEL=openai/gpt-oss-20b
LLM_SOURCE_SELECTOR_MODEL=openai/gpt-oss-20b
LLM_INVESTIGATOR_MODEL=openai/gpt-oss-120b
LLM_JUDGE_MODEL=openai/gpt-oss-120b
LLM_WRITER_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RATE_LIMIT_WAIT_SECONDS=65
LLM_MAX_TOOL_ROUNDS=8
LLM_INVESTIGATOR_MAX_TOKENS=1600
MAX_SOURCE_QUERIES=3
MAX_SOURCE_DOCUMENTS=2
MAX_ANALYSIS_DETAILS=4
MAX_REVIEW_REVISIONS=1
PIPELINE_VERSION=multiagent-groq-v23
BENCHMARK_REPORT_PATH=results/latest-expanded-development-sample5-seed1.json
RESULT_REUSE_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
